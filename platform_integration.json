        "Test cache management",
        "Verify response times"
      ]
    },
    "support": {
      "documentation": "https://ai-p-hcuo.onrender.com/docs",
      "openapi_spec": "https://ai-p-hcuo.onrender.com/openapi.json",
      "integration_guide": "INTEGRATION_MANIFEST_COMPLETE.md",
      "status_page": "/health"
    },
    "metadata": {
      "manifest_version": "1.0",
      "created": "2026-06-09T15:00:00Z",
